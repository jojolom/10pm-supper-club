DEFINE SCHEMA

    RECORD TYPE Club (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE QUERYABLE,
        "founderID"     STRING,
        "memberIDs"     LIST<STRING>,
        "declinedIDs"   LIST<STRING>,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE Member (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE QUERYABLE,
        "name"          STRING,
        "joined"        TIMESTAMP,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE Dinner (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE QUERYABLE,
        "name"          STRING,
        "address"       STRING,
        "neighborhood"  STRING,
        "cuisine"       STRING,
        "date"          TIMESTAMP,
        "latitude"      DOUBLE,
        "longitude"     DOUBLE,
        "attendeeIDs"   LIST<STRING>,
        "addedBy"       STRING,
        "photoIDs"      LIST<STRING>,
        GRANT WRITE TO "_icloud",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE Ranking (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE QUERYABLE,
        "memberID"      STRING,
        "volumeID"      STRING,
        "order"         LIST<STRING>,
        "updated"       TIMESTAMP,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE Review (
        "___createTime"     TIMESTAMP,
        "___createdBy"      REFERENCE,
        "___etag"           STRING,
        "___modTime"        TIMESTAMP,
        "___modifiedBy"     REFERENCE,
        "___recordID"       REFERENCE QUERYABLE,
        "memberID"          STRING,
        "dinnerID"          STRING,
        "note"              STRING,
        "bestDish"          STRING,
        "score_food"        DOUBLE,
        "score_drinks"      DOUBLE,
        "score_service"     DOUBLE,
        "score_cigability"  DOUBLE,
        "score_vibe"        DOUBLE,
        "updated"           TIMESTAMP,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE GuestReview (
        "___createTime"     TIMESTAMP,
        "___createdBy"      REFERENCE,
        "___etag"           STRING,
        "___modTime"        TIMESTAMP,
        "___modifiedBy"     REFERENCE,
        "___recordID"       REFERENCE QUERYABLE,
        "memberID"          STRING,
        "dinnerID"          STRING,
        "score_food"        DOUBLE,
        "score_drinks"      DOUBLE,
        "score_service"     DOUBLE,
        "score_cigability"  DOUBLE,
        "score_vibe"        DOUBLE,
        "updated"           TIMESTAMP,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE Photo (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE QUERYABLE,
        "dinnerID"      STRING,
        "image"         ASSET,
        GRANT WRITE TO "_icloud",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );
